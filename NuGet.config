<?xml version="1.0" encoding="utf-8"?>
<!-- Pin package restore to nuget.org so the build doesn't depend on machine-level NuGet settings. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
